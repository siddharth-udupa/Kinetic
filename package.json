{
  "name": "strava-clone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter mobile --filter tile-provider dev",
    "web": "pnpm --filter web dev",
    "app": "pnpm --filter mobile dev",
    "app:android": "pnpm --filter mobile android",
    "tiles": "pnpm --filter tile_provider dev",
    "lint": "biome lint",
    "check:colors": "node scripts/check-color-utilities.mjs",
    "theme:mobile": "node scripts/generate-mobile-theme.mjs",
    "dbg": "pnpm --filter db dbg",
    "dbm": "pnpm --filter db dbm",
    "dbp": "pnpm --filter db dbp",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.10.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/connect": "^3.4.38",
    "connect": "^3.7.0"
  }
}

{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    /* The shared packages ship raw TypeScript with extensionless internal
       imports, and tsx resolves the engine the same way a bundler would. */
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"]
}

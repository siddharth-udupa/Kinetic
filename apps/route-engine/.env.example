PORT=8003
HOST=127.0.0.1

# Local Valhalla. If it is unreachable and a fallback is set below, the engine
# switches to the fallback once at boot. Inside compose this becomes
# http://valhalla:8002.
VALHALLA_URL=http://localhost:8002

# Optional development fallback. The FOSSGIS instance is convenient when no
# local Valhalla is running, but coordinates are sent to a third party. Remove
# this line to keep routing local-only.
VALHALLA_FALLBACK_URL=https://valhalla1.openstreetmap.de
